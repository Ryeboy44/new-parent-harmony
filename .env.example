# Sanity CMS — blog posts (https://www.sanity.io/manage)
# Create a project, then add these to .env.local (never commit real tokens).
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Optional API version override (default: 2025-01-01)
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: read token for private datasets (server-side only — do NOT prefix with NEXT_PUBLIC_)
# SANITY_API_READ_TOKEN=

# Discovery call email (existing)
# DISCOVERY_CALL_TO=
# DISCOVERY_CALL_FROM=
# RESEND_API_KEY=
# DISCOVERY_CALL_LOG_ONLY=true

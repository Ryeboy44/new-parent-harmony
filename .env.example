# =============================================================================
# Sanity CMS — Blog (https://www.sanity.io/manage → project "New Parent Harmony")
# Copy this file to `.env.local` for local development (never commit `.env.local`).
# Add the same NEXT_PUBLIC_* variables in Vercel → Project → Settings → Environment Variables.
# =============================================================================

# Public (safe in browser) — required for /blog and embedded /studio
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# How to open the CMS
# This project uses the Studio embedded in the Next.js app (not a hosted Sanity “app”).
# Local:  npm run dev  →  http://localhost:3000/studio
# Live:   https://www.newparentharmony.com/studio
# Log in with the same Sanity account that already manages the blog.
# Studio content: Blog Post, Testimonials, Community Collective (settings, events, supporters).
# sanity.io/manage → “No apps found” is expected; do not create a second project or dataset.
#
# Optional standalone Studio (same project/dataset): npm run sanity → http://localhost:3333/studio
# SANITY_STUDIO_PROJECT_ID=
# SANITY_STUDIO_DATASET=production

# Optional API version (default in code: 2025-01-01)
# NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Optional: only if your dataset is private (server-side only — never NEXT_PUBLIC_)
# SANITY_API_READ_TOKEN=

# Optional: instant blog updates after publish (Sanity webhook → POST /api/revalidate?secret=...)
# SANITY_REVALIDATE_SECRET=

# Site URL for Studio preview links and sitemap (production)
# NEXT_PUBLIC_SITE_URL=https://www.newparentharmony.com

# Private form email (discovery call, Community Collective Request Support, and supporter inquiries)
# DISCOVERY_CALL_TO defaults to gemma@newparentharmony.com if unset. Set it in Vercel so it is explicit.
DISCOVERY_CALL_TO=gemma@newparentharmony.com
# DISCOVERY_CALL_FROM=   # required — verified Resend sender, e.g. New Parent Harmony <hello@yourdomain.com>
# RESEND_API_KEY=        # required for delivery
# Leave DISCOVERY_CALL_LOG_ONLY unset in production. true skips Resend and only logs (local testing).
# DISCOVERY_CALL_LOG_ONLY=true
